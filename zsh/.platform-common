# Common platform profile values shared across macOS and Linux.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"

# NVM paths: prefer Homebrew-installed nvm, fall back to $NVM_DIR.
# HOMEBREW_PREFIX is set by `brew shellenv` in .zprofile before this runs.
NVM_SCRIPT="${HOMEBREW_PREFIX:-}/opt/nvm/nvm.sh"
[[ -s "$NVM_SCRIPT" ]] || NVM_SCRIPT="$NVM_DIR/nvm.sh"
NVM_COMPLETION="${HOMEBREW_PREFIX:-}/opt/nvm/etc/bash_completion.d/nvm"
[[ -s "$NVM_COMPLETION" ]] || NVM_COMPLETION="$NVM_DIR/bash_completion"

if [[ -x "${DOTFILES_DIR:-$HOME/.dotfiles}/scripts/secrets.sh" ]]; then
    if _secrets_output="$("${DOTFILES_DIR:-$HOME/.dotfiles}/scripts/secrets.sh" env 2>/dev/null)"; then
        eval "$_secrets_output"
    elif [[ -t 1 ]]; then
        echo "[dotfiles] secrets failed; run 'dotfiles-secrets doctor' to diagnose" >&2
    fi
    unset _secrets_output
fi
