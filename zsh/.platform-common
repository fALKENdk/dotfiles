# Common platform profile values shared across macOS and Linux.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"
DOTFILES_SECRETS_SCRIPT="$DOTFILES_DIR/scripts/secrets.sh"

if [[ -x "$DOTFILES_SECRETS_SCRIPT" ]]; then
    _ds_err="$(mktemp 2>/dev/null || echo "/tmp/.dotfiles-secrets-err.$$")"
    _ds_out="$("$DOTFILES_SECRETS_SCRIPT" env 2>"$_ds_err")" && eval "$_ds_out" || \
        [[ -t 1 ]] && [[ -s "$_ds_err" ]] && echo "[dotfiles] secrets failed; run 'dotfiles-secrets doctor' to diagnose" >&2
    rm -f "$_ds_err"
    unset _ds_err _ds_out
fi
