# Common platform profile values shared across macOS and Linux.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"

if [[ -x "$DOTFILES_DIR/scripts/secrets.sh" ]]; then
    _secrets_stderr="$(mktemp 2>/dev/null || echo "/tmp/.dotfiles-secrets-err.$$")"
    _secrets_output="$("$DOTFILES_DIR/scripts/secrets.sh" env 2>"$_secrets_stderr")" && eval "$_secrets_output" || \
        [[ -t 1 ]] && [[ -s "$_secrets_stderr" ]] && echo "[dotfiles] secrets failed; run 'dotfiles-secrets doctor' to diagnose" >&2
    rm -f "$_secrets_stderr"
    unset _secrets_stderr _secrets_output
fi
