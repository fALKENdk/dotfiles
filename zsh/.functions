alias reload='source ~/.zshrc'

mkcd() {
    mkdir -p "$1" && cd "$1"
}

# Run a command with sudo, or re-run the last command with sudo if called bare.
please() {
    if [[ "$#" -gt 0 ]]; then
        sudo "$@"
        return
    fi

    local last_cmd
    last_cmd="$(fc -ln -1)"
    [[ -z "$last_cmd" || "$last_cmd" == "please" ]] && {
        echo "No previous command to rerun." >&2
        return 1
    }

    print -z "sudo $last_cmd"
}
