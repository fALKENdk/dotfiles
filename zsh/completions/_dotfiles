#compdef dotfiles dotfiles-backup dotfiles-secrets dotfiles-local dotfiles-ssh

_dotfiles() {
    case "$service" in
        dotfiles)
            case $CURRENT in
                2) compadd ${=:-$(dotfiles _completions 2>/dev/null)} ;;
                3)
                    case "${words[2]}" in
                        secrets) compadd ${=:-$(dotfiles-secrets _completions 2>/dev/null)} ;;
                        local) compadd ${=:-$(dotfiles-local _completions 2>/dev/null)} ;;
                        ssh) compadd ${=:-$(dotfiles-ssh _completions 2>/dev/null)} ;;
                        install) compadd -- --skip-macos --restore ;;
                        backup | restore) _files ;;
                    esac
                    ;;
                *) _files ;;
            esac
            ;;
        dotfiles-backup)
            _files
            ;;
        dotfiles-secrets)
            if (( CURRENT == 2 )); then
                compadd ${=:-$(dotfiles-secrets _completions 2>/dev/null)}
            else
                _files
            fi
            ;;
        dotfiles-local)
            if (( CURRENT == 2 )); then
                compadd ${=:-$(dotfiles-local _completions 2>/dev/null)}
            elif [[ "${words[2]}" == "restore" ]]; then
                compadd -- --overwrite
                _files
            else
                _files
            fi
            ;;
        dotfiles-ssh)
            if (( CURRENT == 2 )); then
                compadd ${=:-$(dotfiles-ssh _completions 2>/dev/null)}
            elif [[ "${words[2]}" == "restore" ]]; then
                compadd -- --overwrite
                _files
            else
                _files
            fi
            ;;
    esac
}

_dotfiles "$@"
